# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_AIRTEL_MONEY_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Existing Centipid customer account/voucher portal URL, only when confirmed.
NEXT_PUBLIC_CENTIPID_PORTAL_URL=

# MylesNet organization portal visibility (enable only after WorkOS is configured).
NEXT_PUBLIC_PORTAL_ENABLED=false
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
CONVEX_DEPLOY_KEY=

# Shared server-to-server secret for the Next.js contact route and Convex HTTP action.
CONTACT_API_SECRET=

# Required server-only CSRF settings. CSRF_COOKIE_DOMAIN must be the canonical production domain.
CSRF_COOKIE_DOMAIN=
CSRF_HMAC_SECRET=

# Resend configuration for the shared contact and coverage-request handler.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=

# Optional server-only fallback for the approximate UGX per KES conversion.
# Use only if the exchange-rate provider is unavailable.
EXCHANGE_RATE_FALLBACK_UGX_PER_KES=
